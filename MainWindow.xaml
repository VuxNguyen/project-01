<Window x:Class="WarehouseManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WarehouseManagement.Models"
        Title="Quản Lý Kho Hàng Nón" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#bdc3c7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center"
                                          Foreground="#000000"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7f8c8d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🪖" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock Text="QUẢN LÝ KHO HÀNG NÓN" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Helmet Warehouse Management" 
                               FontSize="12" Foreground="#bdc3c7" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="White"
                                        CornerRadius="8,8,0,0"
                                        Margin="0,0,5,0"
                                        Padding="25,12">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#f5f6fa"/>
                                        <Setter Property="Foreground" Value="#2c3e50"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#ecf0f1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Danh sách nón -->
            <TabItem Header="📦 Danh sách nón" FontSize="14">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Total Count -->
                    <Border Grid.Row="0" Background="#3498db" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel>
                                <TextBlock Text="Tổng số nón trong kho" FontSize="14" Foreground="#ecf0f1"/>
                                <TextBlock x:Name="lblTotalHelmets" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search Panel -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1" Style="{StaticResource ModernTextBox}" 
                                     TextChanged="TxtSearch_TextChanged"/>
                            <Button Grid.Column="2" Content="🔄 Làm mới" Style="{StaticResource ModernButton}" 
                                    Margin="10,0,0,0" Click="BtnRefresh_Click"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10">
                        <DataGrid x:Name="dgvHelmets" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" SelectionMode="Single" 
                                  Background="White" BorderThickness="0"
                                  AlternatingRowBackground="#f8f9fa" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Loại nón" Binding="{Binding HelmetType}" Width="100"/>
                                <DataGridTextColumn Header="Kích thước" Binding="{Binding Size}" Width="70"/>
                                <DataGridTextColumn Header="Hãng" Binding="{Binding Brand}" Width="100"/>
                                <DataGridTextColumn Header="Ngày nhập" Binding="{Binding ImportDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                                <DataGridTextColumn Header="Chất liệu" Binding="{Binding Material}" Width="100"/>
                                <DataGridTextColumn Header="Giá (VND)" Binding="{Binding Price, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="Màu" Binding="{Binding Color}" Width="80"/>
                                <DataGridTextColumn Header="Cân nặng" Binding="{Binding Weight, StringFormat=F1}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="✏️ Chỉnh sửa" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                        <Button Content="🗑️ Xóa" Style="{StaticResource ModernButton}" Background="#e74c3c" Click="BtnDelete_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Thêm nón mới -->
            <TabItem Header="➕ Thêm nón mới" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Form -->
                        <Border Grid.Row="0" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="Thêm nón mới vào kho" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Điền đầy đủ thông tin vào các trường bên dưới" FontSize="13" Foreground="#e8e8e8" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Form Content -->
                        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="30">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="🆔 Mã nón" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtId" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Nhập mã định danh duy nhất" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="🪖 Loại nón" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtHelmetType" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: Nón bảo hiểm, Nón 1/2, Nón fullface" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 1 -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,20">
                                    <TextBlock Text="📏 Kích thước" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtSize" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: S, M, L, XL hoặc 54-56cm" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,20">
                                    <TextBlock Text="🏷️ Hãng sản xuất" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtBrand" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: Royal, Andes, KYT, LS2" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 2 -->
                                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,20">
                                    <TextBlock Text="📅 Ngày nhập kho" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <DatePicker x:Name="dtpImportDate" FontSize="14" BorderBrush="#bdc3c7" BorderThickness="1">
                                        <DatePicker.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                    <TextBlock Text="Chọn ngày nhập vào kho" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,20">
                                    <TextBlock Text="🧱 Chất liệu" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtMaterial" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: Nhựa ABS, Carbon, Sợi thủy tinh" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 3 -->
                                <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,20">
                                    <TextBlock Text="💰 Giá tiền (VND)" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtPrice" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Nhập giá bán lẻ" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="3" Margin="0,0,0,20">
                                    <TextBlock Text="🎨 Màu sắc" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtColor" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: Đen, Trắng, Đỏ, Xanh" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 4 -->
                                <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,20">
                                    <TextBlock Text="⚖️ Cân nặng (kg)" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtWeight" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: 1.2, 1.5, 2.0" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Empty placeholder -->
                                <StackPanel Grid.Column="2" Grid.Row="4" Margin="0,0,0,20"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="25" Margin="0,20,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnSave" Content="💾 Lưu thông tin" Style="{StaticResource ModernButton}" 
                                        Background="#2ecc71" FontSize="15" FontWeight="SemiBold"
                                        Padding="30,12" Margin="0,0,15,0" Click="BtnSave_Click">
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#27ae60" Direction="270"/>
                                    </Button.Effect>
                                </Button>
                                <Button x:Name="btnClear" Content="🧹 Xóa trắng" Style="{StaticResource ModernButton}" 
                                        Background="#95a5a6" FontSize="15" FontWeight="SemiBold"
                                        Padding="30,12" Click="BtnClear_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
