<Window x:Class="WarehouseManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WarehouseManagement.Models"
        Title="Quản Lý Kho Hàng Nón" 
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        MaxHeight="1200" MaxWidth="1920"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#bdc3c7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Foreground="#000000"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7f8c8d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#bdc3c7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <Grid/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#ecf0f1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="12,0,0,0"/>
                            <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  Data="M0,0 L4,4 L8,0 Z"
                                  Fill="#7f8c8d"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        BorderBrush="#bdc3c7"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="60"/>
            <RowDefinition Height="*" MinHeight="400"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#2c3e50" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock x:Name="HeaderIcon" Text="🪖" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="QUẢN LÝ KHO HÀNG NÓN" 
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="Helmet Warehouse Management" 
                                   FontSize="12" Foreground="#bdc3c7" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="15" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="White"
                                        CornerRadius="8,8,0,0"
                                        Margin="0,0,5,0"
                                        Padding="25,12">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#f5f6fa"/>
                                        <Setter Property="Foreground" Value="#2c3e50"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#ecf0f1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Danh sách nón -->
            <TabItem Header="📦 Danh sách nón" FontSize="14">
                <Grid x:Name="Tab1Grid" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="60"/>
                        <RowDefinition Height="Auto" MinHeight="60"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="Auto" MinHeight="50"/>
                    </Grid.RowDefinitions>

                    <!-- Total Count -->
                    <Border x:Name="TotalCountBorder" Grid.Row="0" Background="#3498db" CornerRadius="10" Padding="20,15" Margin="0,0,0,15" MinHeight="70">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TotalCountIcon" Text="📊" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TotalCountLabel" Text="Tổng số nón trong kho" FontSize="14" Foreground="#ecf0f1"/>
                                <TextBlock x:Name="lblTotalHelmets" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search Panel -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1" Style="{StaticResource ModernTextBox}" 
                                     TextChanged="TxtSearch_TextChanged"/>
                            <Button Grid.Column="2" Content="🔄 Làm mới" Style="{StaticResource ModernButton}" 
                                    Margin="10,0,0,0" Click="BtnRefresh_Click"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgvHelmets" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single"
                                  CanUserResizeColumns="True"
                                  IsReadOnly="True"
                                  Background="White" BorderThickness="0"
                                  AlternatingRowBackground="#f8f9fa" RowHeight="40"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Loại nón" Binding="{Binding HelmetType}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Kích thước" Binding="{Binding Size}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Hãng sản xuất" Binding="{Binding Brand}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ngày nhập kho" Binding="{Binding ImportDate, StringFormat=dd/MM/yyyy}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Chất liệu" Binding="{Binding Material}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Giá tiền (VND)" Binding="{Binding Price, StringFormat=N0}" Width="130" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Màu sắc" Binding="{Binding Color}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cân nặng (gram)" Binding="{Binding Weight, StringFormat=F0}" Width="130" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel x:Name="ActionButtonsPanel" Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button x:Name="btnEdit" Content="✏️ Chỉnh sửa" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="BtnEdit_Click" MinWidth="100"/>
                        <Button x:Name="btnDelete" Content="🗑️ Xóa" Style="{StaticResource ModernButton}" Background="#e74c3c" Click="BtnDelete_Click" MinWidth="80"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Thêm nón mới -->
            <TabItem Header="➕ Thêm nón mới" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Form -->
                        <Border Grid.Row="0" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="Thêm nón mới vào kho" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Điền đầy đủ thông tin vào các trường bên dưới" FontSize="13" Foreground="#e8e8e8" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Form Content -->
                        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="30">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Mã nón" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtId" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Nhập mã định danh duy nhất" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Loại nón" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cmbHelmetType" Style="{StaticResource ModernComboBox}"
                                              FontSize="14" Padding="12,10">
                                        <ComboBoxItem Content="1/2"/>
                                        <ComboBoxItem Content="3/4"/>
                                        <ComboBoxItem Content="Fullface"/>
                                    </ComboBox>
                                    <TextBlock Text="Chọn loại nón" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 1 -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,20">
                                    <TextBlock Text="Kích thước" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cmbSize" Style="{StaticResource ModernComboBox}"
                                              FontSize="14" Padding="12,10">
                                        <ComboBoxItem Content="S"/>
                                        <ComboBoxItem Content="M"/>
                                        <ComboBoxItem Content="L"/>
                                        <ComboBoxItem Content="XL"/>
                                        <ComboBoxItem Content="XXL"/>
                                        <ComboBoxItem Content="XXXL"/>
                                    </ComboBox>
                                    <TextBlock Text="Chọn kích thước" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,20">
                                    <TextBlock Text="Hãng sản xuất" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtBrand" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Nhập tên hãng sản xuất" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 2 -->
                                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,20">
                                    <TextBlock Text="Ngày nhập kho" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <DatePicker x:Name="dtpImportDate" FontSize="14" BorderBrush="#bdc3c7" BorderThickness="1">
                                        <DatePicker.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                    <TextBlock Text="Chọn ngày nhập vào kho" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,20">
                                    <TextBlock Text="Chất liệu" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtMaterial" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: Nhựa ABS, Carbon, Sợi thủy tinh" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 3 -->
                                <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,20">
                                    <TextBlock Text="Giá tiền (VND)" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtPrice" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"
                                             TextChanged="TxtPrice_TextChanged" PreviewKeyDown="TxtPrice_PreviewKeyDown"/>
                                    <TextBlock Text="Chỉ nhập số, tự động thêm dấu chấm" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="3" Margin="0,0,0,20">
                                    <TextBlock Text="Màu sắc" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtColor" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Ví dụ: Đen, Trắng, Đỏ, Xanh" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Row 4 -->
                                <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,20">
                                    <TextBlock Text="Cân nặng (gram)" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtWeight" Style="{StaticResource ModernTextBox}" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Chỉ nhập số nguyên (không nhập dấu chấm/phẩy)" FontSize="11" Foreground="#95a5a6" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Empty placeholder -->
                                <StackPanel Grid.Column="2" Grid.Row="4" Margin="0,0,0,20"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="25" Margin="0,20,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnSave" Content="Lưu thông tin" Style="{StaticResource ModernButton}"
                                        Background="#2ecc71" FontSize="15" FontWeight="SemiBold"
                                        Padding="30,12" Margin="0,0,15,0" Click="BtnSave_Click">
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#27ae60" Direction="270"/>
                                    </Button.Effect>
                                </Button>
                                <Button x:Name="btnClear" Content="Xóa trắng" Style="{StaticResource ModernButton}"
                                        Background="#95a5a6" FontSize="15" FontWeight="SemiBold"
                                        Padding="30,12" Click="BtnClear_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
