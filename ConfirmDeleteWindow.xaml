<Window x:Class="WarehouseManagement.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận xóa" 
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#f5f6fa">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#e74c3c" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗑️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Xác nhận xóa" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Message -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="25">
            <StackPanel>
                <TextBlock Text="Bạn có chắc chắn muốn xóa nón này?" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <Border Background="#fef9e7" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,5"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </StackPanel.Resources>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🆔 Mã: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblId"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪖 Loại nón: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblHelmetType"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📏 Kích thước: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblSize"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️ Hãng: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblBrand"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 Ngày nhập: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblImportDate"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧱 Chất liệu: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblMaterial"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 Giá: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblPrice"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨 Màu: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblColor"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖️ Cân nặng: " FontWeight="Bold" Width="100"/>
                            <TextBlock x:Name="lblWeight"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <TextBlock Text="⚠️ Hành động này không thể hoàn tác!" FontSize="12" Foreground="#e74c3c" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="❌ Hủy" Style="{StaticResource ModernButton}" Background="#95a5a6" FontSize="14" Padding="20,10" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="✅ Xác nhận xóa" Style="{StaticResource ModernButton}" Background="#e74c3c" FontSize="14" Padding="20,10" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
