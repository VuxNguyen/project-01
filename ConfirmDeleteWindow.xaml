<Window x:Class="WarehouseManagement.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận xóa"
        Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#f5f6fa">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info Label Style -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7f8c8d"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Info Value Style -->
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#e74c3c" Padding="25,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗑️" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock Text="Xác nhận xóa" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Vui lòng kiểm tra kỹ trước khi xóa" FontSize="13" Foreground="#fadbd8" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30">
            <StackPanel>
                <TextBlock Text="Bạn có chắc chắn muốn xóa nón này?" FontSize="16" FontWeight="Bold" 
                           Foreground="#2c3e50" Margin="0,0,0,20"/>

                <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#fadbd8" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🆔" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Mã nón" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblId" Style="{StaticResource InfoValue}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🪖" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Loại nón" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblHelmetType" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📏" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Kích thước" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblSize" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🏷️" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Hãng sản xuất" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblBrand" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📅" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Ngày nhập" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblImportDate" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🧱" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Chất liệu" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblMaterial" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 3 -->
                        <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="💰" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Giá tiền" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblPrice" Style="{StaticResource InfoValue}" FontWeight="Bold" Foreground="#27ae60"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🎨" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Màu sắc" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblColor" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 4 -->
                        <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="⚖️" FontSize="16" Width="25"/>
                            <StackPanel>
                                <TextBlock Text="Cân nặng" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="lblWeight" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#fef9e7" CornerRadius="8" Padding="15" Margin="0,20,0,0" BorderBrush="#f9e79f" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Hành động này không thể hoàn tác! Dữ liệu sẽ bị xóa vĩnh viễn." 
                                   FontSize="13" Foreground="#d68910" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" Padding="25" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="❌ Hủy" Style="{StaticResource ModernButton}" Background="#95a5a6" 
                        FontSize="15" Padding="30,14" Margin="0,0,15,0" Click="BtnCancel_Click"/>
                <Button Content="✅ Xác nhận xóa" Style="{StaticResource ModernButton}" Background="#e74c3c" 
                        FontSize="15" Padding="30,14" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
