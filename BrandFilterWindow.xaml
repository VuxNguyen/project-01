<Window x:Class="WarehouseManagement.BrandFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lọc theo hãng sản xuất"
        Height="550" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#f0f2f5">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1f6dad"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2ecc71"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27ae60"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#e74c3c"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c0392b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Subtle Button Style -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#636e72"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f1f2f6"/>
                                <Setter Property="Foreground" Value="#2d3436"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" CornerRadius="8" Margin="15,15,15,10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Lọc theo hãng sản xuất" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Chọn một hoặc nhiều hãng để lọc" FontSize="12" Foreground="#bdc3c7" Margin="0,5,0,0"/>
                </StackPanel>
                <Button x:Name="btnAddBrand" Grid.Column="1" Content="➕ Thêm hãng mới" 
                        Style="{StaticResource SecondaryButton}" Click="BtnAddBrand_Click"/>
            </Grid>
        </Border>
        
        <!-- Brand List -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="15,0,15,10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BrandList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder" Tag="{Binding Name}" Background="White" BorderThickness="1" 
                                    BorderBrush="#ecf0f1" CornerRadius="8" Margin="5" Padding="12"
                                    Cursor="Hand" MouseLeftButtonDown="BrandItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Logo -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" 
                                            Background="#ecf0f1" Margin="0,0,12,0">
                                        <Image Source="{Binding LogoPath}" Stretch="UniformToFill" 
                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    
                                    <!-- Brand Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                               FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#2c3e50" 
                                               VerticalAlignment="Center"/>
                                    
                                    <!-- Selection Checkbox indicator -->
                                    <Border x:Name="CheckIndicator" Grid.Column="2" Width="28" Height="28" 
                                            CornerRadius="14" BorderThickness="2" BorderBrush="#bdc3c7" 
                                            Background="Transparent" VerticalAlignment="Center">
                                        <TextBlock x:Name="CheckIcon" Text="{Binding CheckIcon}" 
                                                   FontSize="16" FontWeight="Bold" 
                                                   Foreground="#27ae60" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="15,0,15,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnClearFilter" Grid.Column="0" Content="🔄 Xóa bộ lọc" 
                        Style="{StaticResource SubtleButton}" Click="BtnClearFilter_Click"
                        HorizontalAlignment="Left"/>
                
                <Button x:Name="btnCancel" Grid.Column="1" Content="Hủy" 
                        Style="{StaticResource ModernButton}" Background="#95a5a6"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="btnApply" Grid.Column="2" Content="✓ Áp dụng" 
                        Style="{StaticResource SecondaryButton}" Click="BtnApply_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
