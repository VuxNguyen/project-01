<Window x:Class="WarehouseManagement.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa thông tin nón"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#f5f6fa">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#bdc3c7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#2c3e50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Foreground="#2c3e50"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7f8c8d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#bdc3c7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#ecf0f1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="15,0,0,0"/>
                            <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  Data="M0,0 L4,4 L8,0 Z"
                                  Fill="#7f8c8d"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        BorderBrush="#bdc3c7"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Hint Text Style -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#95a5a6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#3498db" Padding="25,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✏️" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock Text="Chỉnh sửa thông tin nón" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Cập nhật thông tin sản phẩm bên dưới" FontSize="13" Foreground="#e8f4f8" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scrollable Form Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30">
            <Border Background="White" CornerRadius="12" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="Mã nón" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtId" Style="{StaticResource ModernTextBox}" IsEnabled="False"/>
                        <TextBlock Text="Mã định danh duy nhất (không thể chỉnh sửa)" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="Loại nón" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbHelmetType" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="1/2"/>
                            <ComboBoxItem Content="3/4"/>
                            <ComboBoxItem Content="Fullface"/>
                        </ComboBox>
                        <TextBlock Text="Chọn loại nón" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,25">
                        <TextBlock Text="Kích thước" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbSize" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="S"/>
                            <ComboBoxItem Content="M"/>
                            <ComboBoxItem Content="L"/>
                            <ComboBoxItem Content="XL"/>
                            <ComboBoxItem Content="XXL"/>
                            <ComboBoxItem Content="XXXL"/>
                        </ComboBox>
                        <TextBlock Text="Chọn kích thước" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,25">
                        <TextBlock Text="Hãng sản xuất" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbBrand" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Royal"/>
                            <ComboBoxItem Content="Andes"/>
                        </ComboBox>
                        <TextBlock Text="Chọn hãng sản xuất" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,25">
                        <TextBlock Text="Ngày nhập kho" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="dtpImportDate" FontSize="14" Height="45">
                            <DatePicker.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="BorderBrush" Value="#bdc3c7"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                        <TextBlock Text="Chọn ngày sản phẩm nhập kho" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,25">
                        <TextBlock Text="Chất liệu" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtMaterial" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="Ví dụ: Nhựa ABS, Carbon, Sợi thủy tinh" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <!-- Row 3 -->
                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,25">
                        <TextBlock Text="Giá tiền (VND)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtPrice" Style="{StaticResource ModernTextBox}"
                                 TextChanged="TxtPrice_TextChanged" PreviewKeyDown="TxtPrice_PreviewKeyDown"/>
                        <TextBlock Text="Chỉ nhập số, tự động thêm dấu chấm" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="3" Margin="0,0,0,25">
                        <TextBlock Text="Màu sắc" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtColor" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="Ví dụ: Đen, Trắng, Đỏ, Xanh dương" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <!-- Row 4 -->
                    <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,25">
                        <TextBlock Text="Cân nặng (gram)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtWeight" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="Chỉ nhập số nguyên, đơn vị gram" Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" Padding="25" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="❌ Hủy" Style="{StaticResource ModernButton}" Background="#95a5a6" 
                        FontSize="15" Padding="30,14" Margin="0,0,15,0" Click="BtnCancel_Click"/>
                <Button Content="💾 Lưu thay đổi" Style="{StaticResource ModernButton}" Background="#2ecc71" 
                        FontSize="15" Padding="30,14" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
